# ── Supabase ──────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxx

# ── Brain Module Auth ─────────────────────────────────────────
# Generate a strong random string. Must match BRAIN_API_KEY in Python .env
# Example: openssl rand -hex 32
BRAIN_API_KEY=your_strong_random_secret_here

# ── Server ────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
